# Database
DB_PATH=./data/energy_tracker.db

# Garmin credentials
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password
GARMIN_TOKEN_DIR=./data/.garmin_tokens

# HabitSync connection
HABITSYNC_URL=http://habitsync:6842
HABITSYNC_API_KEY=your_api_key

# Optional settings
TZ=Europe/London
SYNC_HOUR=6
SYNC_MINUTE_GARMIN=0
SYNC_MINUTE_ENVIRONMENT=5
SYNC_MINUTE_HOME_ASSISTANT=10
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
ENVIRONMENT_LATITUDE=
ENVIRONMENT_LONGITUDE=
DEBUG=false
